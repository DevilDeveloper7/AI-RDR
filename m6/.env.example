# Copy to .env (cp .env.example .env). Never commit .env.
# --- M6 backend ---
APP_ENV=development
FLASK_DEBUG=0
HOST=127.0.0.1
# 5001, not 5000: on macOS, port 5000 is used by AirPlay Receiver.
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYST_NAME="Muhammad Alam"

# --- M1-M5 integration settings ---
# PROVISIONAL / M6 STUB: no real M1-M5 interface has been confirmed yet.
# MODE is "mock" (built-in stub, the default) or "real" (not implemented yet).
# BASE_URL stays empty until the owner of each module confirms their interface.
# Do not hardcode teammate IP addresses here.
M1_MODE=mock
M1_BASE_URL=
M2_MODE=mock
M2_BASE_URL=
M3_MODE=mock
M3_BASE_URL=
M4_MODE=mock
M4_BASE_URL=
M5_MODE=mock
M5_BASE_URL=
